# Copy this file to dashboard/.env and fill in the real values.
# dashboard/.env is git-ignored. Real environment variables always win over
# anything set here, so a Windows service or systemd unit can override it.
#
# Generate a token with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------- required
# Shared secret for dashboard login. Leave EMPTY only if the dashboard is
# reachable from localhost alone: a non-loopback bind without a token makes
# the app refuse to start. Minimum 16 characters.
DASHBOARD_AUTH_TOKEN=

# ---------------------------------------------------------------- optional
# Where the dashboard listens. Keep 127.0.0.1 when using Cloudflare Tunnel,
# because cloudflared runs on this same machine.
#   127.0.0.1 = localhost only (default)
#   0.0.0.0   = every interface (LAN); requires a token
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# How long a signed session stays valid, in hours.
DASHBOARD_SESSION_HOURS=12

# Force the Secure flag on cookies even if the proxy header is missing.
# Only needed if TLS is terminated somewhere that does not send
# X-Forwarded-Proto. Leave empty when using stock cloudflared.
# DASHBOARD_SECURE_COOKIES=false

# Browser origins allowed to call the API cross-origin. Leave EMPTY for
# same-origin only, which is what the tunnel needs. Comma-separated.
# DASHBOARD_ALLOWED_ORIGINS=https://weighbridge.example.com

# Peers whose X-Forwarded-* headers are trusted. Never use "*".
DASHBOARD_TRUSTED_PROXY_IPS=127.0.0.1

# Brute-force protection for the login endpoint.
DASHBOARD_LOGIN_MAX_ATTEMPTS=5
DASHBOARD_LOGIN_WINDOW_SECONDS=300

# Publish /docs and /openapi.json. Off by default: they describe the OPC-UA
# write endpoint in full.
# DASHBOARD_ENABLE_DOCS=false

# Override the Content-Security-Policy only if CDN assets fail to load in a
# browser. Set to an empty value to disable the header entirely.
# DASHBOARD_CSP=
